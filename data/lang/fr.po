msgstr "N'écoute pas : %s"

#: src/ui/ui_common.cpp
msgid "Not listening yet."
msgstr "N'écoute pas encore."

#: src/ui/ui_common.cpp
msgid "Listening on port %u; no client connected."
msgstr "À l'écoute sur le port %u ; aucun client connecté."

#: src/ui/ui_common.cpp
msgid "Listening on port %u; clients connected: %u."
msgstr "À l'écoute sur le port %u ; clients connectés : %u."

#: src/ui/ui_common.cpp
msgid "What the game sends shows here while it runs (Tab in a game): each name, its type, its meaning and its value. README.md lists them for every game."
msgstr "Ce que le jeu envoie s'affiche ici pendant qu'il tourne (Tab dans un jeu) : chaque nom, son type, son sens et sa valeur. README.md les liste pour chaque jeu."

#: src/ui/ui_common.cpp
