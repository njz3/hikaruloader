msgstr ""

#: src/ui/ui_common.cpp
msgid "Listening on port %u; clients connected: %u."
msgstr ""

#: src/ui/ui_common.cpp
msgid "What the game sends shows here while it runs (Tab in a game): each name, its type, its meaning and its value. README.md lists them for every game."
msgstr ""

